flowchart LR
    subgraph VSCode["VS Code extension host (Restricted Mode ok)"]
        View["Workspace view (webview)"] --> Cmds["Connect / Refresh / Disconnect commands"]
        Cmds --> Conn["engine_connection.ts"]
        Settings["User settings only: executable + data paths"] --> Conn
    end
    Conn --> SDK["@vcp/sdk (typed envelopes, receipts, pull events)"]
