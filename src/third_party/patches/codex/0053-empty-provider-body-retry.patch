+#[cfg(test)]
+mod vcp_response_start_tests {
+    use super::*;
+    use codex_client::TransportError;
+    use std::time::Duration;
+
+    #[tokio::test]
+    async fn empty_body_and_decode_failure_remain_typed_transport_errors() {
+        for items in [
+            vec![],
+            vec![Ok(bytes::Bytes::new())],
+            vec![Err(TransportError::Network(
+                "error decoding response body".into(),
+            ))],
+            vec![
+                Ok(bytes::Bytes::new()),
+                Err(TransportError::Network("decode failure".into())),
+            ],
+        ] {
+            let result = prefetch_response_body(
+                futures::stream::iter(items).boxed(),
+                Duration::from_secs(1),
+            )
+            .await;
+            assert!(matches!(
+                result,
+                Err(ApiError::Transport(TransportError::Network(_)))
+            ));
+        }
+    }
+
+    #[tokio::test]
+    async fn first_bytes_are_preserved_and_later_failure_is_not_a_startup_retry() {
+        // Even an SSE comment or an incomplete event is observed response data.
+        for first in [b": keepalive\n\n".as_slice(), b"data: {".as_slice()] {
+            let first = bytes::Bytes::copy_from_slice(first);
+            let items = vec![
+                Ok(bytes::Bytes::new()),
+                Ok(first.clone()),
+                Err(TransportError::Network("later disconnect".into())),
+            ];
+            let mut stream = prefetch_response_body(
+                futures::stream::iter(items).boxed(),
+                Duration::from_secs(1),
+            )
+            .await
+            .unwrap();
+            assert_eq!(stream.next().await.unwrap().unwrap(), first);
+            assert!(matches!(
+                stream.next().await,
+                Some(Err(TransportError::Network(_)))
+            ));
+            assert!(stream.next().await.is_none());
+        }
+    }
+
+    #[tokio::test]
+    async fn idle_timeout_bounds_silent_and_empty_chunk_streams() {
+        for stream in [
+            futures::stream::pending().boxed(),
+            futures::stream::repeat_with(|| Ok(bytes::Bytes::new())).boxed(),
+        ] {
+            let result = tokio::time::timeout(
+                Duration::from_secs(2),
+                prefetch_response_body(stream, Duration::from_millis(20)),
+            )
+            .await
+            .unwrap();
+            assert!(matches!(
+                result,
+                Err(ApiError::Transport(TransportError::Timeout))
+            ));
+        }
+    }
+
+    #[tokio::test]
+    async fn host_deadline_and_capture_failure_are_not_reclassified_as_network_errors() {
+        let expired = bounded_response_stream(
+            futures::stream::pending().boxed(),
+            std::time::Instant::now(),
+        );
+        let result = prefetch_response_body(expired, Duration::from_secs(1)).await;
+        assert!(matches!(
+            result,
+            Err(ApiError::Transport(TransportError::Build(_)))
+        ));
+        let failed =
+            futures::stream::iter([Err(TransportError::Build("capture failed".into()))]).boxed();
+        let result = prefetch_response_body(failed, Duration::from_secs(1)).await;
+        assert!(matches!(
+            result,
+            Err(ApiError::Transport(TransportError::Build(_)))
+        ));
+    }
+}
