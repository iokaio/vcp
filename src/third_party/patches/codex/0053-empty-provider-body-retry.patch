+// VCP: prefetch only for captured host requests, before synthetic header events
+// or provider events can escape. Preserve the first nonempty chunk verbatim;
+// the existing capture wrapper records it exactly once before SSE parsing.
+async fn prefetch_response_body(
+    mut bytes: codex_client::ByteStream,
+    idle_timeout: std::time::Duration,
+) -> Result<codex_client::ByteStream, ApiError> {
+    let deadline = tokio::time::Instant::now() + idle_timeout;
+    loop {
+        if tokio::time::Instant::now() >= deadline {
+            return Err(codex_client::TransportError::Timeout.into());
+        }
+        let item = tokio::time::timeout_at(deadline, bytes.next())
+            .await
+            .map_err(|_| codex_client::TransportError::Timeout)?;
+        match item {
+            Some(Ok(first)) if !first.is_empty() => {
+                return Ok(futures::stream::once(async move { Ok(first) })
+                    .chain(bytes)
+                    .boxed());
+            }
+            Some(Ok(_)) => tokio::task::yield_now().await,
+            Some(Err(error)) => return Err(error.into()),
+            None => {
+                return Err(codex_client::TransportError::Network(
+                    "provider response body closed before any bytes were received".into(),
+                )
+                .into());
+            }
+        }
+    }
+}
