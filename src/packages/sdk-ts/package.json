{
  "name": "@vcp/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for VCP's authenticated local API.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build:examples && node --test tests/*.test.mjs",
    "check:examples": "tsc --noEmit -p tsconfig.examples.json",
    "build:examples": "npm run build && tsc -p tsconfig.examples.json"
  },
  "dependencies": {
    "@vcp/protocol": "file:../protocol-ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
