{
  "name": "vcp-local",
  "displayName": "VCP Local",
  "description": "Local VCP workspace connection, trust and recovery.",
  "publisher": "vcp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": { "vscode": "1.138.0" },
  "extensionKind": ["ui"],
  "main": "./dist/extension.js",
  "activationEvents": ["onView:vcp.connection","onView:vcp.tasks","onCommand:vcp.connect","onCommand:vcp.refreshConnection","onCommand:vcp.disconnect","onCommand:vcp.connectController","onCommand:vcp.attachObserver","onCommand:vcp.reconcileRoot","onCommand:vcp.grantTrust","onCommand:vcp.revokeTrust","onStartupFinished","onCommand:vcp.startEditorTask","onCommand:vcp.createEditDraft","onCommand:vcp.reviewEditorDrafts","onCommand:vcp.applyEditorChanges","onCommand:vcp.inspectEditorChanges","onCommand:vcp.refreshEditorObservations"],
  "capabilities": {
    "virtualWorkspaces": { "supported": false, "description": "VCP currently connects only to local Windows file workspaces." },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Observation, explicit root reconciliation and trust revocation are available. Tasks and project edits are not started.",
      "restrictedConfigurations": ["vcp.engineExecutable", "vcp.dataDirectory"]
    }
  },
  "contributes": {
    "commands": [
      { "command": "vcp.connect", "title": "VCP: Connect to Local Workspace" },
      { "command": "vcp.refreshConnection", "title": "VCP: Refresh Connection" },
      { "command": "vcp.disconnect", "title": "VCP: Disconnect" },
      {"command":"vcp.connectController","title":"VCP: Connect as Controller"},
      {"command":"vcp.attachObserver","title":"VCP: Observe Existing Engine"},
      {"command":"vcp.reconcileRoot","title":"VCP: Reconcile Moved Root"},
      {"command":"vcp.grantTrust","title":"VCP: Trust Engine Workspace"},
      {"command":"vcp.revokeTrust","title":"VCP: Revoke Engine Workspace Trust"},
      {"command":"vcp.startEditorTask","title":"VCP: Start Execution-backed Task"},
      {"command":"vcp.createEditDraft","title":"VCP: Create Editor Draft"},
      {"command":"vcp.reviewEditorDrafts","title":"VCP: Review Editor Drafts"},
      {"command":"vcp.applyEditorChanges","title":"VCP: Apply Reviewed Editor Changes"},
      {"command":"vcp.inspectEditorChanges","title":"VCP: Inspect Editor Change Outcomes"},
      {"command":"vcp.refreshEditorObservations","title":"VCP: Refresh Editor Observations"}
    ],
    "viewsContainers": { "activitybar": [{ "id": "vcp", "title": "VCP", "icon": "media/vcp.svg" }] },
    "views": { "vcp": [{ "type": "webview", "id": "vcp.connection", "name": "Workspace" }, { "type": "webview", "id": "vcp.tasks", "name": "Tasks" }] },
    "configuration": {
      "title": "VCP",
      "properties": {
        "vcp.engineExecutable": { "type": "string", "default": "", "scope": "machine", "description": "Absolute path to a trusted vcp.exe, configured in User settings. Workspace overrides are ignored." },
        "vcp.dataDirectory": { "type": "string", "default": "", "scope": "machine", "description": "Absolute path to the existing VCP data directory, configured in User settings. Workspace overrides are ignored." }
      }
    }
  },
  "scripts": {
    "build": "npm --prefix ../sdk-ts run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "stage": "npm run build && node scripts/stage.cjs"
  },
  "dependencies": { "@vcp/sdk": "file:../sdk-ts", "@vcp/protocol": "file:../protocol-ts" },
  "devDependencies": { "@types/node": "24.10.1", "@types/vscode": "1.138.0", "typescript": "5.9.3" }
}
