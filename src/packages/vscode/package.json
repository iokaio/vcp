{
  "name": "vcp-local",
  "displayName": "VCP Local",
  "description": "Read-only connection to an initialized local VCP workspace.",
  "publisher": "vcp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": { "vscode": "1.138.0" },
  "extensionKind": ["ui"],
  "main": "./dist/extension.js",
  "activationEvents": ["onView:vcp.connection", "onCommand:vcp.connect", "onCommand:vcp.refreshConnection", "onCommand:vcp.disconnect"],
  "capabilities": {
    "virtualWorkspaces": { "supported": false, "description": "VCP currently connects only to local Windows file workspaces." },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Only read-only inspection is available. This extension does not start tasks or apply project changes.",
      "restrictedConfigurations": ["vcp.engineExecutable", "vcp.dataDirectory"]
    }
  },
  "contributes": {
    "commands": [
      { "command": "vcp.connect", "title": "VCP: Connect to Local Workspace" },
      { "command": "vcp.refreshConnection", "title": "VCP: Refresh Connection" },
      { "command": "vcp.disconnect", "title": "VCP: Disconnect" }
    ],
    "viewsContainers": { "activitybar": [{ "id": "vcp", "title": "VCP", "icon": "media/vcp.svg" }] },
    "views": { "vcp": [{ "type": "webview", "id": "vcp.connection", "name": "Workspace" }] },
    "configuration": {
      "title": "VCP",
      "properties": {
        "vcp.engineExecutable": { "type": "string", "default": "", "scope": "machine", "description": "Absolute path to a trusted vcp.exe, configured in User settings. Workspace overrides are ignored." },
        "vcp.dataDirectory": { "type": "string", "default": "", "scope": "machine", "description": "Absolute path to the existing VCP data directory, configured in User settings. Workspace overrides are ignored." }
      }
    }
  },
  "scripts": {
    "build": "npm --prefix ../sdk-ts run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "stage": "npm run build && node scripts/stage.cjs"
  },
  "dependencies": { "@vcp/sdk": "file:../sdk-ts", "@vcp/protocol": "file:../protocol-ts" },
  "devDependencies": { "@types/node": "24.10.1", "@types/vscode": "1.138.0", "typescript": "5.9.3" }
}
