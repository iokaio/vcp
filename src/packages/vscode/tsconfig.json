{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": false, "declaration": true, "rootDir": "src", "outDir": "dist",
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
