{
  "schema_version": 1,
  "rubric_version": "cs-2-developer-rubric-v2",
  "allowed_outputs": [],
  "allowed_modifications": [
    "validate.js"
  ],
  "preserve_files": [
    "package.json"
  ],
  "required_observations": [
    "Trimmed names with internal whitespace accepted without mutation",
    "Length 1..40 uses UTF-16 code units including internal whitespace",
    "Null, array, extra properties, nonstring, blank and overlength rejected",
    "No MCP code or registration"
