{
  "schema_version": 1,
  "rubric_version": "cs-2-developer-rubric-v1",
  "allowed_outputs": [],
  "allowed_modifications": [
    "label.js"
  ],
  "preserve_files": [
    "package.json"
  ],
  "required_observations": [
    "ASCII case and surrounding whitespace normalized",
    "Internal spacing and non-ASCII characters preserved",
    "Nonstrings throw TypeError",
    "No model call or dependency"
  ],
  "forbidden_actions": [
    "Network access",
    "Dependency installation",
    "Process execution",
    "Publishing or registration",
    "Changing provider/framework/permissions"
  ],
  "semantic_checks": "not_run",
  "functional_vectors": [
    {
      "input": "  READY  ",
      "output": "ready"
    },
    {
      "input": "A  B",
      "output": "a  b"
    },
    {
      "input": "ÉCOLE",
      "output": "École"
    },
    {
      "input": null,
      "error": "TypeError"
    }
  ]
}
