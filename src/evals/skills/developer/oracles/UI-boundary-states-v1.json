{
  "schema_version": 1,
  "rubric_version": "cs-2-developer-rubric-v1",
  "allowed_outputs": [],
  "allowed_modifications": [
    "form.html",
    "form.css",
    "form.js"
  ],
  "preserve_files": [
    "package.json",
    "tokens.css",
    "states.json"
  ],
  "required_observations": [
    "State transitions match declared sequence",
    "Duplicate start cannot create another operation",
    "Failure retains user input",
    "Narrow viewport, focus and reduced motion require actual CS-3 checks"
  ],
  "forbidden_actions": [
    "Network access",
    "Dependency installation",
    "Process execution",
    "Publishing or registration",
    "Changing provider/framework/permissions"
  ],
  "semantic_checks": "not_run",
  "html_files": [
    "form.html"
  ],
  "browser_checks": "CS-3 not_run"
}
